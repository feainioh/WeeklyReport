<UserControl x:Class="WeeklyReport.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- [旧代码-界面现代化2] 原视图上边距 14，现与全局卡片节奏统一为 16 -->
    <!-- <Grid Margin="0,14,0,0"> -->
    <Grid Margin="0,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- [旧代码-界面现代化2] 原卡片：Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="18" -->
        <Border Style="{StaticResource ModernCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="刷新周报" Command="{Binding RefreshWeeksCommand}"
                            IsEnabled="{Binding CanInteract}" Style="{StaticResource SecondaryButton}" />
                    <!-- [旧代码-界面现代化2] 原区域标题 FontSize="18" FontWeight="SemiBold" -->
                    <TextBlock Text="导入与导出" Style="{StaticResource SectionTitleText}" />
                </DockPanel>
                <!-- [旧代码-界面现代化2] 原说明行 TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" -->
                <TextBlock Grid.Row="1" Margin="0,10,0,12" Style="{StaticResource CaptionText}"
                           Text="JSON 导出全部业务数据；Excel 可选择一周或多周；Markdown 仅支持单篇周报。备份包含明文业务数据。" />
                <ListBox Grid.Row="2" ItemsSource="{Binding Weeks}" Background="Transparent" BorderThickness="0"
                         IsEnabled="{Binding CanInteract}">
                    <!-- [旧代码-界面现代化2] 原本地行样式仅拉伸内容，覆盖全局行样式导致无悬停/选中反馈
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    -->
                    <!-- [新增-界面现代化2] 基于全局行样式，仅补充内容拉伸 -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}"
                                      Foreground="{DynamicResource TextBrush}" Margin="3,7" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel Grid.Row="3" Margin="0,14,0,0">
                    <Button Content="导出 JSON 全部" Click="ExportJson_Click" IsEnabled="{Binding CanInteract}" />
                    <Button Content="导出选中 Excel" Click="ExportExcel_Click" IsEnabled="{Binding CanExportSelected}"
                            Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" />
                    <Button Content="导出单篇 Markdown" Click="ExportMarkdown_Click" IsEnabled="{Binding CanExportSingle}" />
                    <Button Content="导入备份" Click="Import_Click" IsEnabled="{Binding CanInteract}" />
                </WrapPanel>
            </Grid>
        </Border>
        <!-- [旧代码-界面现代化2] 原状态行 TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" -->
        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}"
                   Margin="0,10,0,0" />
    </Grid>
</UserControl>
