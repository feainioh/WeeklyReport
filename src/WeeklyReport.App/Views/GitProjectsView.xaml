<UserControl x:Class="WeeklyReport.App.Views.GitProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- [旧代码-界面现代化2] 原视图上边距 14，现与全局卡片节奏统一为 16 -->
    <!-- <Grid Margin="0,14,0,0"> -->
    <Grid Margin="0,16,0,0">
        <!-- [旧代码-去嵌套] 原两行布局（内容 + 状态栏）
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        -->
        <!-- [新增-去嵌套] 三段布局：分段开关 / 内容 / 状态栏 -->
        <!-- [旧代码-去嵌套2] 二次去嵌套后恢复两行（分段开关并入卡片头部，不再独占一行）
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        -->
        <!-- [新增-去嵌套2] 两行布局：单卡片内容 + 状态栏 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- [旧代码-去嵌套2] 原页面级分段开关（卡外双层盒子）：轨道移入卡片头部并去边框（见下方）
        <Border Background="{DynamicResource HoverBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="3" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ProjectsSegment" Content="项目与同步" GroupName="GitMode"
                             Style="{StaticResource SegmentRadioButton}" IsChecked="True" />
                <RadioButton x:Name="WorkItemsSegment" Content="Git 工作项" GroupName="GitMode"
                             Style="{StaticResource SegmentRadioButton}" />
            </StackPanel>
        </Border>
        -->

        <!-- [旧代码-去嵌套2] 原“项目与同步”段：左列两张卡（项目列表卡 + 同步预览卡）加右侧编辑卡，共三盒并排；
             现“项目与同步”与“Git 工作项”各合并为一张主从面板卡（左列表/分区 + 竖分隔线 + 右编辑器），每段一层盒子。
             原各卡片 ModernCard 外壳 Border 均已去除，内部内容原样迁入下方面板。 -->

        <!-- [新增-去嵌套2] 单卡片布局：分段开关作卡片头部，两个分段面板同卡切换 -->
        <Border Style="{StaticResource ModernCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- [新增-去嵌套2] 卡片头部分段开关：轨道仅保留极淡底色，无边框 -->
                <Border Background="{DynamicResource HoverBrush}" CornerRadius="8" Padding="3"
                        HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ProjectsSegment" Content="项目与同步" GroupName="GitMode"
                                     Style="{StaticResource SegmentRadioButton}" IsChecked="True" />
                        <RadioButton x:Name="WorkItemsSegment" Content="Git 工作项" GroupName="GitMode"
                                     Style="{StaticResource SegmentRadioButton}" />
                    </StackPanel>
                </Border>

                <!-- [新增-去嵌套2] 内容区：两个分段面板同格互斥显示 -->
                <Grid Grid.Row="1" Margin="0,16,0,0">

                    <!-- [新增-去嵌套2] 项目与同步面板：左（项目列表 + 横分隔线 + 同步预览）| 竖分隔线 | 右（项目编辑器） -->
                    <Grid Visibility="{Binding IsChecked, ElementName=ProjectsSegment,
                                               Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="17" />
                            <ColumnDefinition Width="350" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="17" />
                                <RowDefinition Height="3*" />
                            </Grid.RowDefinitions>
                            <!-- [新增-去嵌套2] 项目列表区（原左上卡片内容原样迁入，卡片外壳去除） -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshCommand}"
                                            IsEnabled="{Binding CanInteract}" Style="{StaticResource SecondaryButton}" />
                                    <!-- [旧代码-界面现代化2] 原区域标题 FontSize="17" FontWeight="SemiBold" -->
                                    <TextBlock Text="选择要同步的项目" Style="{StaticResource SectionTitleText}" />
                                </DockPanel>
                                <ListBox Grid.Row="1" ItemsSource="{Binding Projects}" IsEnabled="{Binding CanInteract}"
                                         Background="Transparent" BorderThickness="0" Margin="0,10,0,0">
                                    <!-- [新增-界面现代化2] 基于全局行样式，仅补充内容拉伸 -->
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="2,6">
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <!-- [新增-界面现代化2] 行内操作改为紧凑次要按钮 -->
                                                    <Button Content="编辑" Style="{StaticResource CompactButton}"
                                                            Command="{Binding DataContext.EditProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="删除" Style="{StaticResource CompactButton}" Margin="0"
                                                            Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <CheckBox Content="{Binding Project.Name}" IsChecked="{Binding IsSelected}"
                                                          Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                            <!-- [新增-去嵌套2] 横向分隔线：替代原两卡之间的盒式分隔 -->
                            <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource RowSeparatorBrush}"
                                       VerticalAlignment="Center" Margin="0,8" />
                            <!-- [新增-去嵌套2] 同步预览区（原左下卡片内容原样迁入） -->
                            <Grid Grid.Row="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- [旧代码-界面现代化2] 原区域标题 FontSize="17" FontWeight="SemiBold" -->
                                <TextBlock Text="同步预览" Style="{StaticResource SectionTitleText}" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                                    <DatePicker AutomationProperties.Name="Git 同步开始日期"
                                                SelectedDate="{Binding StartDate}" Width="135" IsEnabled="{Binding CanInteract}" />
                                    <TextBlock Text="至" Margin="8,0" VerticalAlignment="Center" />
                                    <DatePicker AutomationProperties.Name="Git 同步结束日期"
                                                SelectedDate="{Binding EndDate}" Width="135" IsEnabled="{Binding CanInteract}" />
                                    <Button Content="预览同步" Margin="10,0,8,0" Command="{Binding PrepareSyncCommand}"
                                            IsEnabled="{Binding CanInteract}" />
                                </StackPanel>
                                <TextBox Grid.Row="2" AutomationProperties.Name="Git 同步预览"
                                         Text="{Binding PreviewText}" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                                <Button Grid.Row="3" Content="确认并应用" Command="{Binding ApplySyncCommand}"
                                        IsEnabled="{Binding CanApplyPreview}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" />
                            </Grid>
                        </Grid>
                        <!-- [新增-去嵌套2] 竖向分隔线：主从分栏的轻量边界 -->
                        <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource RowSeparatorBrush}"
                                   HorizontalAlignment="Center" Margin="0,4" />
                        <!-- [新增-去嵌套2] 项目编辑器（原右列卡片内容原样迁入） -->
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel IsEnabled="{Binding CanInteract}">
                                <!-- [旧代码-界面现代化2] 原区域标题 FontSize="17" FontWeight="SemiBold" -->
                                <TextBlock Text="{Binding ProjectEditorTitle}" Style="{StaticResource SectionTitleText}" TextWrapping="Wrap" />
                                <TextBlock Text="项目名称" Margin="0,14,0,5" />
                                <TextBox AutomationProperties.Name="Git 项目名称" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="本地仓库" Margin="0,14,0,5" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="浏览" Click="BrowseRepository_Click" Margin="8,0,0,0" />
                                    <TextBox AutomationProperties.Name="Git 仓库路径"
                                             Text="{Binding RepositoryPath, UpdateSourceTrigger=PropertyChanged}" />
                                </DockPanel>
                                <TextBlock Text="作者匹配方式" Margin="0,14,0,5" />
                                <ComboBox ItemsSource="{Binding AuthorOptions}" DisplayMemberPath="Label"
                                          SelectedValuePath="Value" SelectedValue="{Binding AuthorField}" />
                                <TextBlock Text="作者姓名或邮箱" Margin="0,14,0,5" />
                                <TextBox AutomationProperties.Name="Git 作者"
                                         Text="{Binding Author, UpdateSourceTrigger=PropertyChanged}" />
                                <!-- [旧代码-界面现代化2] 原说明行 TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" -->
                                <TextBlock Text="仅同步当前 HEAD 可达且作者精确匹配的提交。"
                                           Style="{StaticResource CaptionText}" Margin="0,12,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="保存项目" Command="{Binding SaveProjectCommand}"
                                            Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" />
                                    <Button Content="新建项目" Command="{Binding NewProjectCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- [新增-去嵌套2] Git 工作项面板：左（工作项列表）| 竖分隔线 | 右（工作项编辑器） -->
                    <Grid Visibility="{Binding IsChecked, ElementName=WorkItemsSegment,
                                               Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="17" />
                            <ColumnDefinition Width="350" />
                        </Grid.ColumnDefinitions>
                        <!-- [新增-去嵌套2] 工作项列表（原左列卡片内容原样迁入） -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <DatePicker AutomationProperties.Name="Git 工作项查询日期" SelectedDate="{Binding WorkWeek}"
                                            Width="140" IsEnabled="{Binding CanInteract}" />
                                <Button Content="查询工作项" Command="{Binding RefreshCommand}"
                                        IsEnabled="{Binding CanInteract}" Margin="10,0,0,0" />
                                <Button Content="重算所选日期" Command="{Binding RecalculateDateCommand}"
                                        IsEnabled="{Binding CanInteract}" Margin="8,0,0,0" />
                            </StackPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding WorkItems}" IsEnabled="{Binding CanInteract}"
                                     Background="Transparent" BorderThickness="0" Margin="0,12,0,0">
                                <!-- [新增-界面现代化2] 基于全局行样式，仅补充内容拉伸 -->
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <!-- [旧代码-界面现代化2] 原行分隔线 BorderBrush="{DynamicResource MutedBrush}" -->
                                        <Border BorderBrush="{DynamicResource RowSeparatorBrush}" BorderThickness="0,0,0,1" Padding="4,10">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                    <!-- [新增-界面现代化2] 行内操作改为紧凑次要按钮 -->
                                                    <Button Content="编辑" Style="{StaticResource CompactButton}"
                                                            Command="{Binding DataContext.EditWorkItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="删除" Style="{StaticResource CompactButton}" Margin="0"
                                                            Command="{Binding DataContext.DeleteWorkItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Item.ProjectName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Item.WorkDate, StringFormat={}{0:yyyy-MM-dd}}" />
                                                    <TextBlock Text="{Binding Item.Description}" TextWrapping="Wrap" Margin="0,5,8,0" />
                                                    <TextBlock Text="{Binding HoursDisplay}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <!-- [新增-去嵌套2] 竖向分隔线 -->
                        <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource RowSeparatorBrush}"
                                   HorizontalAlignment="Center" Margin="0,4" />
                        <!-- [新增-去嵌套2] 工作项编辑器（原右列卡片内容原样迁入） -->
                        <Grid Grid.Column="2" IsEnabled="{Binding CanEditWorkItem}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- [旧代码-界面现代化2] 原区域标题 FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" -->
                            <TextBlock Text="{Binding WorkEditorTitle}" Style="{StaticResource SectionTitleText}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Text="工作项描述" Margin="0,14,0,5" />
                            <TextBox Grid.Row="2" AutomationProperties.Name="Git 工作项描述"
                                     Text="{Binding WorkDescription, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            <TextBlock Grid.Row="3" Text="确认工时（小时，留空使用估算）" Margin="0,12,0,5" />
                            <TextBox Grid.Row="4" AutomationProperties.Name="Git 确认工时"
                                     Text="{Binding WorkHours, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="保存工作项" Command="{Binding SaveWorkItemCommand}"
                                        Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" />
                                <Button Content="DeepSeek 润色" Command="{Binding PolishWorkItemCommand}" />
                                <Button Content="取消编辑" Command="{Binding CancelWorkEditCommand}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- [旧代码-去嵌套] 原状态栏为 Grid.Row="1"，新增分段开关行后下移为第 2 行 -->
        <!-- [旧代码-去嵌套2] 分段开关并入卡片后恢复为第 1 行 -->
        <DockPanel Grid.Row="1" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="取消当前操作" Command="{Binding CancelSyncCommand}"
                    IsEnabled="{Binding IsSyncing}" Style="{StaticResource SecondaryButton}" />
            <!-- [旧代码-界面现代化2] 原状态行 TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" -->
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" />
        </DockPanel>
    </Grid>
</UserControl>
