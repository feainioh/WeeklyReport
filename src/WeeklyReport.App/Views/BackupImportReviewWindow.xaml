<Window x:Class="WeeklyReport.App.Views.BackupImportReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认导入" Width="640" Height="460" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="请核对导入数量和冲突；备份包含明文业务数据。" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBox x:Name="SummaryText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="导入预览" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="跳过重复并导入" Click="Skip_Click" IsDefault="True"
                    Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" />
            <Button Content="覆盖重复并导入" Click="Overwrite_Click" />
            <Button Content="取消" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
