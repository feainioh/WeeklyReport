<Window x:Class="WeeklyReport.App.Views.AiReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720" Height="560" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBox x:Name="ReviewText" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" AutomationProperties.Name="待确认内容" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="ConfirmButton" Click="Confirm_Click" Background="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource AccentTextBrush}" />
            <Button Content="取消" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
