<UserControl x:Class="WeeklyReport.App.Controls.FloatingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- [新增-悬浮精灵] 切片 1：从 FloatingWindow.xaml 原样迁出的悬浮卡片内容，视觉与交互保持一致；
         事件通过 OpenRequested / HideRequested / HeaderDragPressed 交回 FloatingWindow 处理。 -->
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource MutedBrush}"
            BorderThickness="1" CornerRadius="10" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                <TextBlock Text="周报" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="拖动" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" />
            </DockPanel>
            <TextBlock x:Name="WeekText" Grid.Row="1" Margin="0,10,0,0" />
            <TextBlock x:Name="ReminderStatusText" Grid.Row="2" Text="提醒正在初始化。"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Row="3" Orientation="Horizontal">
                <Button Content="打开记录" Click="Open_Click" Background="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource AccentTextBrush}" />
                <Button Content="收起" Click="Hide_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
