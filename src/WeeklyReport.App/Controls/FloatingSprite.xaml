<UserControl x:Class="WeeklyReport.App.Controls.FloatingSprite"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="75" Height="95" Background="Transparent">
    <!-- [新增-悬浮精灵] 机器人化改版（缩小到原尺寸 50%，窗口 75x95）：天线 + 强调色面罩（白色 LED 眼）+
         嘴部格栅 + 两侧手臂 + 绿色对勾徽章；动画与提醒气泡同前，位移幅度随尺寸减半。
         旧文档形态几何体已按修改规范注释保留于下方（其内部注释因 XAML 注释不可嵌套而随块移除）。 -->
    <UserControl.Resources>
        <Storyboard x:Key="BobStoryboard">
            <!-- [新增-机器人化] 浮动幅度由 4px 减半至 2px -->
            <DoubleAnimation Storyboard.TargetName="BodyTranslate" Storyboard.TargetProperty="Y"
                             To="-2" Duration="0:0:1.6" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="BlinkStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftEyeScale"
                                           Storyboard.TargetProperty="ScaleY" Duration="0:0:0.24">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0.1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightEyeScale"
                                           Storyboard.TargetProperty="ScaleY" Duration="0:0:0.24">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0.1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="SquashStoryboard">
            <DoubleAnimation Storyboard.TargetName="BodyScale" Storyboard.TargetProperty="ScaleY"
                             To="0.92" Duration="0:0:0.12" FillBehavior="HoldEnd" />
        </Storyboard>
        <Storyboard x:Key="UnsquashStoryboard">
            <DoubleAnimation Storyboard.TargetName="BodyScale" Storyboard.TargetProperty="ScaleY"
                             To="1" Duration="0:0:0.12" FillBehavior="HoldEnd" />
        </Storyboard>
        <Storyboard x:Key="JumpStoryboard" RepeatBehavior="3x">
            <!-- [新增-机器人化] 跳动幅度由 26px 减半至 13px -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTranslate"
                                           Storyboard.TargetProperty="Y" Duration="0:0:0.5">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.16" Value="-13" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BounceEase EasingMode="EaseOut" Bounces="2" Bounciness="2.5" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="CelebrateStoryboard">
            <DoubleAnimation Storyboard.TargetName="BadgeScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.35" Duration="0:0:0.18" AutoReverse="True" RepeatBehavior="2x" />
            <DoubleAnimation Storyboard.TargetName="BadgeScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.35" Duration="0:0:0.18" AutoReverse="True" RepeatBehavior="2x" />
        </Storyboard>
    </UserControl.Resources>

    <UserControl.ContextMenu>
        <!-- [新增-悬浮精灵] 右键菜单承载卡片按钮的等价功能：打开周报 / 收起 -->
        <ContextMenu>
            <MenuItem Header="打开周报" Click="OpenMenu_Click" />
            <MenuItem Header="收起精灵" Click="HideMenu_Click" />
        </ContextMenu>
    </UserControl.ContextMenu>

    <!-- [旧代码-机器人化] 原文档形态精灵几何体（120x140，窗口 150x190），整体由机器人造型替代
    <Grid x:Name="BodyRoot" Width="120" Height="140" Margin="15,42,15,8" RenderTransformOrigin="0.5,1">
        <Grid.RenderTransform>
            <TransformGroup>
                <TranslateTransform x:Name="BodyTranslate" />
                <ScaleTransform x:Name="BodyScale" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Rectangle Fill="{DynamicResource SpriteBodyBrush}" RadiusX="18" RadiusY="18"
                   Stroke="{DynamicResource MutedBrush}" StrokeThickness="1" />
        <Grid Height="46" VerticalAlignment="Top">
            <Rectangle Fill="{DynamicResource AccentBrush}" RadiusX="18" RadiusY="18" />
            <Rectangle Fill="{DynamicResource AccentBrush}" Height="24" VerticalAlignment="Bottom" />
        </Grid>
        <Ellipse Width="14" Height="16" Fill="#1F2937" Margin="30,60,0,0"
                 HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="LeftEyeScale" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="14" Height="16" Fill="#1F2937" Margin="0,60,30,0"
                 HorizontalAlignment="Right" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="RightEyeScale" />
            </Ellipse.RenderTransform>
        </Ellipse>
        <Path Data="M 46,96 Q 60,106 74,96" Stroke="#1F2937" StrokeThickness="3"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        <Grid Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="0,0,4,4" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="BadgeScale" />
            </Grid.RenderTransform>
            <Ellipse Fill="#23A455" />
            <Path Data="M 11,21 L 18,28 L 29,13" Stroke="White" StrokeThickness="4.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
        </Grid>
    </Grid>
    -->

    <Grid>
        <!-- [新增-机器人化] 机器人身体层：60x70，窗口 75x95，上方留天线与跳动空间 -->
        <Grid x:Name="BodyRoot" Width="60" Height="70" Margin="7.5,17,7.5,8" RenderTransformOrigin="0.5,1">
            <Grid.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="BodyTranslate" />
                    <ScaleTransform x:Name="BodyScale" />
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- [新增-机器人化] 天线：顶部强调色小球 + 天线杆（位于身体上方，超出网格范围显示） -->
            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"
                     HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-13,0,0" />
            <Rectangle Width="2" Height="8" Fill="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-7,0,0" RadiusX="1" />

            <!-- [新增-机器人化] 两侧手臂：圆角短臂，随身体一起浮动 -->
            <Rectangle Width="5" Height="16" RadiusX="2.5" RadiusY="2.5"
                       Fill="{DynamicResource SpriteBodyBrush}" Stroke="{DynamicResource MutedBrush}"
                       StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                       Margin="-7,0,0,0" />
            <Rectangle Width="5" Height="16" RadiusX="2.5" RadiusY="2.5"
                       Fill="{DynamicResource SpriteBodyBrush}" Stroke="{DynamicResource MutedBrush}"
                       StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Margin="0,0,-7,0" />

            <!-- [新增-机器人化] 身体：圆角矩形，与面罩、嘴部格栅构成机器人头部躯干一体造型 -->
            <Rectangle Fill="{DynamicResource SpriteBodyBrush}" RadiusX="10" RadiusY="10"
                       Stroke="{DynamicResource MutedBrush}" StrokeThickness="1" />

            <!-- [新增-机器人化] 面罩：强调色胶囊，内置白色 LED 眼（支持眨眼动画） -->
            <Rectangle Fill="{DynamicResource AccentBrush}" RadiusX="7" RadiusY="7"
                       Width="44" Height="14" HorizontalAlignment="Center" VerticalAlignment="Top"
                       Margin="0,9,0,0" />
            <Ellipse Width="5" Height="6" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="17,13,0,0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="LeftEyeScale" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="5" Height="6" Fill="White" HorizontalAlignment="Right" VerticalAlignment="Top"
                     Margin="0,13,17,0" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="RightEyeScale" />
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- [新增-机器人化] 嘴部格栅：三根短竖条 -->
            <Rectangle Width="1.6" Height="4.5" RadiusX="0.8" Fill="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="-6.5,31,0,0" />
            <Rectangle Width="1.6" Height="4.5" RadiusX="0.8" Fill="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,31,0,0" />
            <Rectangle Width="1.6" Height="4.5" RadiusX="0.8" Fill="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="6.5,31,0,0" />

            <!-- [新增-机器人化] 对勾徽章：绿底白勾，与图标一致（18x18 缩小版） -->
            <Grid Width="18" Height="18" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,1,1" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="BadgeScale" />
                </Grid.RenderTransform>
                <Ellipse Fill="#23A455" />
                <Path Data="M 5,9.5 L 8,12.5 L 13,6" Stroke="White" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Grid>
        </Grid>

        <!-- [新增-悬浮精灵] 提醒气泡：提醒触发时在精灵头顶弹出，6 秒自动收起或点击关闭 -->
        <Popup x:Name="ReminderBubble" Placement="Top" PlacementTarget="{Binding ElementName=BodyRoot}"
               AllowsTransparency="True" StaysOpen="False">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource MutedBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10,8" MaxWidth="240" Margin="0,0,0,6">
                <TextBlock x:Name="BubbleText" TextWrapping="Wrap" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
