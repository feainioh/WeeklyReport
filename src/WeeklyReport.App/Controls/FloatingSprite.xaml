                <Rectangle Width="12" Height="1.5" Canvas.Left="9" Canvas.Top="7" RadiusX="0.75"
                           Fill="{DynamicResource SpriteHighlightBrush}" Opacity="0.55" />
                <Ellipse x:Name="LeftEyeNormal" Width="8" Height="9" Canvas.Left="17.5" Canvas.Top="10.5"
                         Fill="{DynamicResource SpriteEyeBrush}" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="LeftEyeScale" />
                            <TranslateTransform x:Name="LeftEyeLook" />
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="RightEyeNormal" Width="8" Height="9" Canvas.Left="32.5" Canvas.Top="10.5"
                         Fill="{DynamicResource SpriteEyeBrush}" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="RightEyeScale" />
                            <TranslateTransform x:Name="RightEyeLook" />
                        </TransformGroup>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Path x:Name="LeftEyeHappy" Data="M 0,4 Q 4,0 8,4"
                      Stroke="{DynamicResource SpriteEyeBrush}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Canvas.Left="17.5" Canvas.Top="12" Visibility="Collapsed" />
                <Path x:Name="RightEyeHappy" Data="M 0,4 Q 4,0 8,4"
                      Stroke="{DynamicResource SpriteEyeBrush}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Canvas.Left="32.5" Canvas.Top="12" Visibility="Collapsed" />
                <Path x:Name="LeftEyeDizzy" Data="M 0,0 L 7,7 M 7,0 L 0,7"
                      Stroke="{DynamicResource SpriteEyeBrush}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Canvas.Left="18" Canvas.Top="11.5" Visibility="Collapsed" />
                <Path x:Name="RightEyeDizzy" Data="M 0,0 L 7,7 M 7,0 L 0,7"
                      Stroke="{DynamicResource SpriteEyeBrush}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Canvas.Left="33" Canvas.Top="11.5" Visibility="Collapsed" />

                <Canvas x:Name="MouthGrille" Width="14" Height="4" Canvas.Left="21" Canvas.Top="29">
                    <Rectangle Width="2" Height="4" Canvas.Left="0" RadiusX="1"
                               Fill="{DynamicResource SpriteDetailBrush}" />
                    <Rectangle Width="2" Height="4" Canvas.Left="6" RadiusX="1"
                               Fill="{DynamicResource SpriteDetailBrush}" />
                    <Rectangle Width="2" Height="4" Canvas.Left="12" RadiusX="1"
                               Fill="{DynamicResource SpriteDetailBrush}" />
                </Canvas>
                <Path x:Name="MouthSmile" Data="M 0,0 Q 5,5 10,0"
                      Stroke="{DynamicResource SpriteDetailBrush}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Canvas.Left="24" Canvas.Top="29" Visibility="Collapsed" />
                <Ellipse x:Name="MouthSurprised" Width="6" Height="7" Canvas.Left="26" Canvas.Top="28.5"
                         Fill="{DynamicResource SpriteDetailBrush}" Visibility="Collapsed" />

                <Canvas x:Name="AntennaGroup" Width="14" Height="16" Canvas.Left="22" Canvas.Top="-16"
                    RenderTransformOrigin="0.5,1">
                    <Canvas.RenderTransform><RotateTransform x:Name="AntennaRotate" /></Canvas.RenderTransform>
                    <Ellipse x:Name="AntennaHalo" Width="14" Height="14" Margin="0,-3,0,0" Opacity="0"
                             Stroke="{DynamicResource AntennaAlertBrush}" StrokeThickness="1.5"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="AntennaHaloScale" /></Ellipse.RenderTransform>
                    </Ellipse>
                    <Border Width="12" Height="3" Canvas.Left="1" Canvas.Top="13" CornerRadius="1.5"
                            Background="{DynamicResource SpriteBodyShadeBrush}"
                            BorderBrush="{DynamicResource SpriteInkBrush}" BorderThickness="1.5" />
                    <Rectangle Width="3" Height="9" Canvas.Left="5.5" Canvas.Top="4" RadiusX="1.5"
                               Fill="{DynamicResource SpriteDetailBrush}" />
                    <Ellipse x:Name="AntennaBall" Width="8" Height="8" Canvas.Left="3" Canvas.Top="0"
                             Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource SpriteInkBrush}"
                             StrokeThickness="1.5" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform><ScaleTransform x:Name="AntennaBallScale" /></Ellipse.RenderTransform>
                    </Ellipse>
                </Canvas>
            </Canvas>
        </Canvas>

        <!-- [新增-情景动画] 门、车与笔记本作为独立图层，避免随机器人位移离开窗口。 -->
        <Canvas x:Name="DoorProp" Width="24" Height="34" Canvas.Left="47" Canvas.Top="68"
                Opacity="0" IsHitTestVisible="False">
            <Rectangle Width="22" Height="32" RadiusX="3" RadiusY="3"
                       Fill="{DynamicResource SpriteBodyShadeBrush}"
                       Stroke="{DynamicResource SpriteDetailBrush}" StrokeThickness="1.5" />
            <Ellipse Width="3.5" Height="3.5" Canvas.Left="16" Canvas.Top="14"
                     Fill="{DynamicResource AccentBrush}" />
            <Canvas.RenderTransform>
                <RotateTransform x:Name="DoorRotate" CenterX="1" CenterY="16" />
            </Canvas.RenderTransform>
        </Canvas>
        <Canvas x:Name="CarProp" Width="40" Height="22" Canvas.Left="17.5" Canvas.Top="90"
                Opacity="0" IsHitTestVisible="False">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="CarTranslate" />
            </Canvas.RenderTransform>
            <Rectangle Width="38" Height="8" Canvas.Left="1" Canvas.Top="4" RadiusX="4"
                       Fill="{DynamicResource AccentBrush}"
                       Stroke="{DynamicResource SpriteDetailBrush}" StrokeThickness="1" />
            <Rectangle Width="8" Height="5" Canvas.Left="8" Canvas.Top="5.5" RadiusX="1.5"
                       Fill="{DynamicResource SurfaceBrush}" Opacity="0.8" />
            <Rectangle Width="8" Height="5" Canvas.Left="22" Canvas.Top="5.5" RadiusX="1.5"
                       Fill="{DynamicResource SurfaceBrush}" Opacity="0.8" />
            <Ellipse x:Name="FrontWheel" Width="7" Height="7" Canvas.Left="5" Canvas.Top="12"
                     Fill="{DynamicResource SpriteDetailBrush}"
                     Stroke="{DynamicResource SpriteInkBrush}" StrokeThickness="1"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform x:Name="FrontWheelRotate" /></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse x:Name="RearWheel" Width="7" Height="7" Canvas.Left="26" Canvas.Top="12"
                     Fill="{DynamicResource SpriteDetailBrush}"
                     Stroke="{DynamicResource SpriteInkBrush}" StrokeThickness="1"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform x:Name="RearWheelRotate" /></Ellipse.RenderTransform>
            </Ellipse>
        </Canvas>
        <Canvas x:Name="NotebookProp" Width="18" Height="14" Canvas.Left="0" Canvas.Top="77"
                Opacity="0" IsHitTestVisible="False">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="NotebookTranslate" />
            </Canvas.RenderTransform>
            <Rectangle Width="16" Height="12" RadiusX="1.5"
                       Fill="{DynamicResource SurfaceBrush}"
                       Stroke="{DynamicResource SpriteDetailBrush}" StrokeThickness="1.5" />
            <Line X1="4" Y1="4" X2="13" Y2="4"
                  Stroke="{DynamicResource MutedBrush}" StrokeThickness="1" />
            <Line X1="4" Y1="6" X2="13" Y2="6"
                  Stroke="{DynamicResource MutedBrush}" StrokeThickness="1" />
            <Line X1="4" Y1="8" X2="11" Y2="8"
                  Stroke="{DynamicResource MutedBrush}" StrokeThickness="1" />
        </Canvas>

        <Rectangle x:Name="BubbleAnchor" Width="1" Height="1" Canvas.Left="37" Canvas.Top="24"
                   Fill="Transparent" Opacity="0" IsHitTestVisible="False" />

        <!-- [新增-悬浮精灵] 提醒气泡：提醒触发时在精灵头顶弹出，6 秒自动收起或点击关闭 -->
        <Popup x:Name="ReminderBubble" Placement="Top" PlacementTarget="{Binding ElementName=BubbleAnchor}"
               AllowsTransparency="True" StaysOpen="False">
            <!-- [旧代码-机器人交互] 原气泡仅显示文本
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource MutedBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10,8" MaxWidth="240" Margin="0,0,0,6">
                <TextBlock x:Name="BubbleText" TextWrapping="Wrap" />
            </Border>
            -->
            <!-- [新增-机器人交互] 气泡容器：文本 + 可选“打开周报”动作 + 指向机器人的小尖角 -->
            <Grid Margin="0,0,0,6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource MutedBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10,8" MaxWidth="240">
                    <StackPanel>
                        <TextBlock x:Name="BubbleText" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="BubbleAction" Content="打开周报" Style="{StaticResource CompactButton}"
                                    Margin="0,0,6,0" Visibility="Collapsed" Click="BubbleAction_Click" />
                            <Button x:Name="BubbleSecondaryAction" Content="10 分钟后"
                                    Style="{StaticResource CompactButton}" Visibility="Collapsed"
                                    Click="BubbleSecondaryAction_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Path Grid.Row="1" Data="M 0,0 L 10,0 L 5,6 Z"
                      Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource MutedBrush}"
                      StrokeThickness="1" HorizontalAlignment="Center" Margin="0,-1,0,0" />
            </Grid>
        </Popup>
    </Canvas>
</UserControl>
