<UserControl x:Class="WeeklyReport.App.Controls.FloatingSprite"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="75" Height="115" Background="Transparent"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- [新增-悬浮精灵] 机器人化改版（缩小到原尺寸 50%，窗口 75x95）：天线 + 强调色面罩（白色 LED 眼）+
         嘴部格栅 + 两侧手臂 + 绿色对勾徽章；动画与提醒气泡同前，位移幅度随尺寸减半。
         旧文档形态几何体已按修改规范注释保留于下方（其内部注释因 XAML 注释不可嵌套而随块移除）。 -->
    <!-- [新增-天线状态] 绿色对勾徽章已由天线颜色/动画状态系统替代，徽章几何体注释保留于下方。 -->
    <UserControl.Resources>
        <!-- [旧代码-形象动画2] 常驻全身 bob 已停用，改为天线呼吸。 -->
        <Storyboard x:Key="LegacyBobStoryboard">
            <!-- [新增-机器人化] 浮动幅度由 4px 减半至 2px -->
            <DoubleAnimation Storyboard.TargetName="BodyTranslate" Storyboard.TargetProperty="Y"
                             To="-2" Duration="0:0:1.6" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="BlinkStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftEyeScale"
                                           Storyboard.TargetProperty="ScaleY" Duration="0:0:0.24">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0.1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightEyeScale"
                                           Storyboard.TargetProperty="ScaleY" Duration="0:0:0.24">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="0.1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.24" Value="1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="SquashStoryboard">
            <DoubleAnimation Storyboard.TargetName="BodyScale" Storyboard.TargetProperty="ScaleY"
                             To="0.92" Duration="0:0:0.12" FillBehavior="HoldEnd" />
        </Storyboard>
        <Storyboard x:Key="UnsquashStoryboard">
            <DoubleAnimation Storyboard.TargetName="BodyScale" Storyboard.TargetProperty="ScaleY"
                             To="1" Duration="0:0:0.12" FillBehavior="HoldEnd" />
        </Storyboard>
        <Storyboard x:Key="JumpStoryboard" RepeatBehavior="3x">
            <!-- [新增-机器人化] 跳动幅度由 26px 减半至 13px -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTranslate"
                                           Storyboard.TargetProperty="Y" Duration="0:0:0.5">
                <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.16" Value="-13" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <BounceEase EasingMode="EaseOut" Bounces="2" Bounciness="2.5" />
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <!-- [旧代码-天线状态] 原徽章放大庆祝动画；绿色对勾徽章已移除，庆祝改由天线摆动与球弹跳承担
        <Storyboard x:Key="CelebrateStoryboard">
            <DoubleAnimation Storyboard.TargetName="BadgeScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.35" Duration="0:0:0.18" AutoReverse="True" RepeatBehavior="2x" />
            <DoubleAnimation Storyboard.TargetName="BadgeScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.35" Duration="0:0:0.18" AutoReverse="True" RepeatBehavior="2x" />
        </Storyboard>
        -->

        <!-- [新增-天线状态] 待机呼吸：球透明度与缩放 3 秒周期缓慢起伏 -->
        <Storyboard x:Key="AntennaBreatheStoryboard">
            <DoubleAnimation Storyboard.TargetName="AntennaBall" Storyboard.TargetProperty="Opacity"
                             From="1" To="0.55" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="AntennaBallScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="0.85" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="AntennaBallScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="0.85" Duration="0:0:1.5" AutoReverse="True" RepeatBehavior="Forever" />
        </Storyboard>

        <!-- [新增-天线状态] 提醒：球以 0.5 秒周期快闪 6 次；光环持续放大淡出直至状态结束 -->
        <Storyboard x:Key="AntennaAlertBlinkStoryboard">
            <DoubleAnimation Storyboard.TargetName="AntennaBallScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.4" Duration="0:0:0.25" AutoReverse="True" RepeatBehavior="6x" />
            <DoubleAnimation Storyboard.TargetName="AntennaBallScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.4" Duration="0:0:0.25" AutoReverse="True" RepeatBehavior="6x" />
            <DoubleAnimation Storyboard.TargetName="AntennaHalo" Storyboard.TargetProperty="Opacity"
                             From="0.85" To="0" Duration="0:0:1" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="AntennaHaloScale" Storyboard.TargetProperty="ScaleX"
                             From="0.5" To="1.8" Duration="0:0:1" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="AntennaHaloScale" Storyboard.TargetProperty="ScaleY"
                             From="0.5" To="1.8" Duration="0:0:1" RepeatBehavior="Forever" />
        </Storyboard>

        <!-- [新增-天线状态] 庆祝：球弹跳放大 + 天线杆左右摆动 3 次后自停 -->
        <Storyboard x:Key="AntennaWiggleStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AntennaRotate"
                                           Storyboard.TargetProperty="Angle" Duration="0:0:0.6"
                                           RepeatBehavior="3x">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="-12" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="12" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="AntennaBallScale" Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.35" Duration="0:0:0.3" AutoReverse="True" RepeatBehavior="3x">
                <DoubleAnimation.EasingFunction>
                    <BounceEase EasingMode="EaseOut" Bounces="1" Bounciness="2" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="AntennaBallScale" Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.35" Duration="0:0:0.3" AutoReverse="True" RepeatBehavior="3x">
                <DoubleAnimation.EasingFunction>
                    <BounceEase EasingMode="EaseOut" Bounces="1" Bounciness="2" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- [新增-机器人交互] 空闲东张西望：身体轻摆 + 眼神左右移动，1.2 秒自停 -->
        <Storyboard x:Key="LookAroundStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyRotate"
                                           Storyboard.TargetProperty="Angle" Duration="0:0:1.2">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="4" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="-4" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftEyeLook"
                                           Storyboard.TargetProperty="X" Duration="0:0:1.2">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1.5" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="-1.5" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightEyeLook"
                                           Storyboard.TargetProperty="X" Duration="0:0:1.2">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1.5" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="-1.5" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- [新增-机器人交互] 戳一戳：身体回弹 + 天线轻摆，短促自停 -->
        <!-- [旧代码-形象动画2] 原戳一戳以 0.92 大幅压扁，已改为小幅短动作。 -->
        <Storyboard x:Key="LegacyPokeStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyScale"
                                           Storyboard.TargetProperty="ScaleX" Duration="0:0:0.55">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="1.08" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0.94" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyScale"
                                           Storyboard.TargetProperty="ScaleY" Duration="0:0:0.55">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="0.9" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1.06" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AntennaRotate"
                                           Storyboard.TargetProperty="Angle" Duration="0:0:0.55">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="-8" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="6" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GroundShadow"
                                           Storyboard.TargetProperty="Width" Duration="0:0:0.55">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="46" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="52" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="42" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.55" Value="46" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <!-- [旧代码-形象动画2] 原基础戳一戳保留，现由轻量版本替代。 -->
        <Storyboard x:Key="LegacyBasicPokeStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyScale"
                                           Storyboard.TargetProperty="ScaleY" Duration="0:0:0.3">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.12" Value="0.9" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AntennaRotate"
                                           Storyboard.TargetProperty="Angle" Duration="0:0:0.3">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="-8" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="8" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <!-- [旧代码-形象动画2] 单段挥臂保留，现由双关节挥手替代。 -->
        <Storyboard x:Key="LegacyWaveStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftArm"
                                           Storyboard.TargetProperty="RenderTransform.Angle"
                                           Duration="0:0:1.9">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="14" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.58" Value="58" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.82" Value="145" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.02" Value="118" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.22" Value="145" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.42" Value="118" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.62" Value="145" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.9" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightArm"
                                           Storyboard.TargetProperty="RenderTransform.Angle"
                                           Duration="0:0:1.9">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="-12" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.58" Value="-58" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.82" Value="-58" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.62" Value="-58" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.9" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyScale"
                                           Storyboard.TargetProperty="ScaleY"
                                           Duration="0:0:1.9">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="0.94" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.58" Value="1.04" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.82" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.62" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.9" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyRotate"
                                           Storyboard.TargetProperty="Angle"
                                           Duration="0:0:1.9">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.22" Value="-3" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.58" Value="2" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.82" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.62" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.9" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GroundShadow"
                                           Storyboard.TargetProperty="Opacity"
                                           Duration="0:0:1.9">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.12" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.58" Value="0.1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.82" Value="0.12" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.62" Value="0.12" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.9" Value="0.12" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <!-- [旧代码-形象动画2] 4.2 秒全身舞蹈保留，现由 2.2 秒 TwoStep 替代。 -->
        <Storyboard x:Key="LegacyDanceStoryboard">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTranslate"
                                           Storyboard.TargetProperty="X"
                                           Duration="0:0:4.2">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.72" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="-4" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.58" Value="4" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.96" Value="-4" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.34" Value="4" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.72" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.08" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.5" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:4.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyTranslate"
                                           Storyboard.TargetProperty="Y"
                                           Duration="0:0:4.2">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="3" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.72" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="-8" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.58" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.96" Value="-8" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.34" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.72" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.08" Value="-10" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.5" Value="4" />
                <EasingDoubleKeyFrame KeyTime="0:0:4.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyRotate"
                                           Storyboard.TargetProperty="Angle"
                                           Duration="0:0:4.2">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.72" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="-8" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.58" Value="7" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.96" Value="-8" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.34" Value="7" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.72" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.08" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.5" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:4.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="BodyScale"
                                           Storyboard.TargetProperty="ScaleY"
                                           Duration="0:0:4.2">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="0.88" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.72" Value="1.06" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="1.08" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.58" Value="0.9" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.96" Value="1.08" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.34" Value="0.9" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.72" Value="1.04" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.08" Value="1.12" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.5" Value="0.86" />
                <EasingDoubleKeyFrame KeyTime="0:0:4.2" Value="1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftArm"
                                           Storyboard.TargetProperty="RenderTransform.Angle"
                                           Duration="0:0:4.2">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="18" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.72" Value="72" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="82" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.58" Value="52" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.96" Value="82" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.34" Value="52" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.72" Value="70" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.08" Value="125" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.5" Value="22" />
                <EasingDoubleKeyFrame KeyTime="0:0:4.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightArm"
                                           Storyboard.TargetProperty="RenderTransform.Angle"
                                           Duration="0:0:4.2">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="-18" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.72" Value="-72" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="-52" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.58" Value="-82" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.96" Value="-52" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.34" Value="-82" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.72" Value="-70" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.08" Value="-125" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.5" Value="-22" />
                <EasingDoubleKeyFrame KeyTime="0:0:4.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="LeftLeg"
                                           Storyboard.TargetProperty="RenderTransform.Angle"
                                           Duration="0:0:4.2">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="18" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.72" Value="34" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="24" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.58" Value="-18" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.96" Value="24" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.34" Value="-18" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.72" Value="34" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.08" Value="-20" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.5" Value="18" />
                <EasingDoubleKeyFrame KeyTime="0:0:4.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RightLeg"
                                           Storyboard.TargetProperty="RenderTransform.Angle"
                                           Duration="0:0:4.2">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.35" Value="-18" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.72" Value="-34" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="-18" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.58" Value="24" />
                <EasingDoubleKeyFrame KeyTime="0:0:1.96" Value="-18" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.34" Value="24" />
                <EasingDoubleKeyFrame KeyTime="0:0:2.72" Value="-34" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.08" Value="20" />
                <EasingDoubleKeyFrame KeyTime="0:0:3.5" Value="-18" />
                <EasingDoubleKeyFrame KeyTime="0:0:4.2" Value="0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="AntennaRotate"
                                           Storyboard.TargetProperty="Angle"
